# ── Apify ─────────────────────────────────────────────────────────────────────
# Get your token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# For Office 365 / Outlook: smtp.office365.com, port 587
# For Gmail: smtp.gmail.com, port 587 (use an App Password, not your main password)
# For generic SMTP providers: check your provider's docs
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=kurt@thefulfillmenthouse.org
SMTP_PASS=your_email_password_or_app_password_here

# ── Recipient ──────────────────────────────────────────────────────────────────
EMAIL_TO=kurt@thefulfillmenthouse.org
