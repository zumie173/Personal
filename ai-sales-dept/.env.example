# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Claude / Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Apify ───────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_...

# ── Google Sheets ────────────────────────────────────────────────────────────
# Path to your service account JSON (download from Google Cloud Console)
GOOGLE_SHEETS_CREDENTIALS_JSON=/path/to/service-account.json
# The spreadsheet ID from the URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# ── Optional overrides ───────────────────────────────────────────────────────
DEFAULT_MAX_RESULTS=200
