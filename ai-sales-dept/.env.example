# Copy to .env and fill in values. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://user:password@localhost:5432/tfh_sales
API_SECRET_KEY=generate-a-random-64-char-string

# Phase 1 — Google Sheets
GOOGLE_SHEETS_CREDENTIALS_JSON=/path/to/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Phase 2 — Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Apify
APIFY_API_TOKEN=apify_api_...

# Hunter.io
HUNTER_API_KEY=
